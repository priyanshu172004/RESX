# ---------------------------------------------------------------------------
# RESX environment template.
#
# Copy to .env and fill in. .env is git-ignored; this file must never contain
# a real secret. Every value below is a placeholder.
#
# Generate the signing keypair:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
RESX_ENV=development                 # development | staging | production
RESX_LOG_LEVEL=info
RESX_BASE_URL=http://localhost:3000
RESX_API_URL=http://localhost:8000

# --- Database: MongoDB ----------------------------------------------------
# auto   -> MongoDB when MONGODB_URL is set and reachable, else SQLite
# mongo  -> require MongoDB; refuse to start if it is unreachable
# sqlite -> the single-file backend, explicitly
#
# `auto` with no URL is the zero-setup path: tests and benchmarks run with no
# server at all. Set MONGODB_URL to use the real backend.
STORE_BACKEND=auto

# A single-node replica set, which `docker compose up -d mongo` provides.
# The replica set is not optional decoration: change streams and multi-document
# transactions need an oplog, and a standalone mongod has none.
MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=resx
MONGODB_TIMEOUT_MS=5000
# A user with no write privileges, handed to the read-only MCP server, so a
# model-generated query is physically incapable of writing.
# See docs/08-DATA-MODEL.md §6.
MONGODB_READONLY_URL=

# The SQLite fallback. Empty means "beside STORAGE_LOCAL_ROOT", which keeps the
# database next to the uploads it describes. Relative paths anchor to the
# repository root, never to the process working directory -- uvicorn starts in
# services/api and the CLI at the root, and resolving against the cwd silently
# gives them two different databases.
SQLITE_PATH=

# --- Redis (queue, rate limits, cache) ------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------
# RS256 keypair, PEM. Asymmetric so a compromised verifier cannot mint tokens.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=resx
JWT_AUDIENCE=resx-web
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800     # 7 days

# Argon2id parameters. Memory-hard on purpose — do not lower these to speed up
# login. 64 MiB is the floor, not a suggestion.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# 32-byte base64 key for encrypting TOTP secrets and sensitive columns at rest.
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Model providers ------------------------------------------------------
# Held by the API service only. Never exposed to the browser, and never placed
# in a prompt or reachable from generated sandbox code.
#
# auto  -> use Groq if GROQ_API_KEY is set, otherwise Anthropic
# groq  -> force Groq       (free tier: https://console.groq.com/keys)
# anthropic -> force Claude
LLM_PROVIDER=auto

# --- Groq (the free option) ----------------------------------------------
GROQ_API_KEY=gsk_replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq rotates its catalog and withdraws ids without notice, so the API checks
# these against the live model list at startup and names the replacements.
GROQ_MODEL_REASONING=openai/gpt-oss-120b   # Finance, Risk, Critic, Synthesizer
GROQ_MODEL_FAST=openai/gpt-oss-20b         # Manager, News, Market, Workflow
# The free tier limits by tokens per minute, so a 429 is retried after a pause
# rather than immediately -- an instant retry just burns the next refill.
GROQ_MAX_RETRIES=3
GROQ_RETRY_BACKOFF_SECONDS=2.0

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
RESX_MODEL_REASONING=claude-opus-5       # Finance, Risk, Critic, Synthesizer
RESX_MODEL_FAST=claude-sonnet-5          # Manager, News, Market, Workflow

# --- Retrieval ------------------------------------------------------------
# The embedding settings live in ONE place, further down under "Embeddings".
# They used to be declared here as well, and a duplicated key in a .env file is
# not an error -- the last one silently wins -- so editing the block a reader
# found first changed nothing and there was no way to tell.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=50

# --- Web search (News, Market agents) ------------------------------------
TAVILY_API_KEY=replace-me
# Egress allowlist for fetch_url. Empty means deny all.
SEARCH_EGRESS_ALLOWLIST=api.tavily.com

# --- Object storage (raw uploads) ----------------------------------------
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Sandbox --------------------------------------------------------------
# The least-trusted component: it executes model-generated code and is treated
# as hostile by default.
SANDBOX_IMAGE=resx/sandbox:0.1.0
SANDBOX_CPU_SECONDS=2
SANDBOX_MEMORY_MB=512
SANDBOX_WALL_TIMEOUT_SECONDS=30
SANDBOX_NETWORK=none

# --- Budgets (an unbounded agent loop is a financial DoS) ----------------
RUN_MAX_USD=5.00
RUN_MAX_TOKENS=2000000
RUN_MAX_NODES=40
RUN_MAX_DEBATE_ROUNDS=3
WORKSPACE_MONTHLY_USD_CAP=50.00

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_BYTES=104857600           # 100 MB per file
WORKSPACE_STORAGE_MAX_BYTES=2147483648
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Rate limits (requests per window; see docs/05-SECURITY.md §5) -------
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_RUN_PER_HOUR=10
RATE_LIMIT_CHAT_PER_HOUR=60

# --- Observability -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Embeddings ---
# voyage | gemini | hashing
#
# `gemini` is here for the rate limit, not the quality: Voyage's free tier is
# 3 requests and 10,000 tokens per minute, and the token ceiling binds first,
# so a real PDF spends most of its ingest waiting out 429s.
#
# Switching provider invalidates every stored vector -- an embedding only means
# anything inside its own model's space -- so re-ingest the corpus after a
# change. Leave EMBEDDING_MODEL empty to take the provider's default; a model
# name from the other provider is refused at startup.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=
# gemini-embedding-001 supports 3072, 1536 and 768 natively.
EMBEDDING_DIMENSIONS=1024
